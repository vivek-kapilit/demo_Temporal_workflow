# --- Temporal connection (matches docker-compose.yml) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=payment-task-queue

# --- App database (SQLite file, created automatically) ---
DATABASE_PATH=payments.db

# --- Business rules ---
# Payments above this amount (INR) wait for human approval.
APPROVAL_THRESHOLD=50000
# If nobody approves/rejects within this many seconds, the payment is auto-rejected.
APPROVAL_TIMEOUT_SECONDS=600

# --- Demo pacing (makes each step visible in the UI) ---
# Artificial delay inside every activity.
STEP_DELAY_SECONDS=2
# Extra delay inside "process_payment" - long enough to kill the worker mid-step.
PROCESSING_DELAY_SECONDS=10

# --- CORS for the React dev server ---
FRONTEND_ORIGIN=http://localhost:5173
